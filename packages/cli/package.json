{
  "name": "@origin-studio/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "origin-studio": "dist/cli/src/index.js"
  },
  "main": "dist/cli/src/index.js",
  "types": "dist/cli/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "origin-studio": "tsx src/index.ts"
  },
  "dependencies": {
    "@origin-studio/core": "workspace:*",
    "@origin-studio/origin-creator-adapter": "workspace:*",
    "@origin-studio/profiles": "workspace:*",
    "@origin-studio/project-indexer": "workspace:*",
    "@origin-studio/validator": "workspace:*"
  }
}
